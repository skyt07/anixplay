# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ignore pages that are not yet implemented
/src/app/%28pages%29/az-list/page.tsx
/src/app/%28pages%29/browser/page.tsx
/src/app/%28pages%29/genres/page.tsx
/src/app/%28pages%29/user/page.tsx
/src/app/%28pages%29/watch/page.tsx